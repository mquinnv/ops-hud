{
  "name": "ops-hud",
  "version": "2.0.1",
  "description": "CI and ops dashboard for the terminal — GitHub Actions and Buildkite",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "ops-hud": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mquinnv/ops-hud.git"
  },
  "bugs": {
    "url": "https://github.com/mquinnv/ops-hud/issues"
  },
  "homepage": "https://github.com/mquinnv/ops-hud#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "bun run tsc",
    "dev": "bun --watch src/index.ts",
    "start": "bun dist/index.js",
    "lint": "bun biome check --write .",
    "check": "bun biome check .",
    "format": "bun biome format --write .",
    "test": "bun test",
    "ops-hud": "bun dist/index.js",
    "prepublishOnly": "bun run build && bun run check && bun test"
  },
  "keywords": [
    "github",
    "workflow",
    "monitoring",
    "cli",
    "terminal",
    "dashboard",
    "buildkite",
    "ci"
  ],
  "author": "Michael Quinn",
  "license": "MIT",
  "packageManager": "bun@1.1.31",
  "devDependencies": {
    "@biomejs/biome": "^2.2.3",
    "@types/blessed": "^0.1.25",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.3.1",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "blessed": "^0.1.81",
    "chalk": "^5.6.2",
    "commander": "^14.0.0",
    "date-fns": "^4.1.0",
    "execa": "^9.6.0"
  }
}
